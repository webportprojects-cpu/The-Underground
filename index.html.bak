<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-box, initial-scale=1.0">
    <title>The Underground</title>
    <meta name="description" content="A fan site for Undertale and Deltarune games">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'VT323', monospace;
            background: linear-gradient(135deg, #0a0a2a, #1a002a);
            color: #ff00ff;
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(255, 0, 255, 0.1) 0%, transparent 20%),
                radial-gradient(circle at 80% 70%, rgba(255, 0, 255, 0.1) 0%, transparent 20%),
                radial-gradient(circle at 40% 40%, rgba(138, 43, 226, 0.05) 0%, transparent 15%),
                radial-gradient(circle at 60% 60%, rgba(138, 43, 226, 0.05) 0%, transparent 15%);
            animation: float 20s ease-in-out infinite;
            pointer-events: none;
            z-index: -2;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(2deg); }
        }

        body::after {
            content: '';
            position: fixed;
            top: 0;
            left = 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(255, 0, 255, 0.05) 2px,
                rgba(255, 0, 255, 0.05) 4px
            );
            pointer-events: none;
            z-index: -1;
            animation: gridMove 10s linear infinite;
        }

        @keyframes gridMove {
            0% { background-position: 0 0; }
            100% { background-position: 100px 100px; }
        }

        a {
            color: #ff00ff;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 10;
        }

        header {
            text-align: center;
            padding: 40px 20px;
            border-bottom: 2px solid #ff00ff;
            margin-bottom: 40px;
            position: relative;
        }

        header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, transparent, #ff00ff, transparent);
            animation: sweep 2s linear infinite;
        }

        @keyframes sweep {
            0% { background-position: -200px 0; }
            100% { background-position: 200px 0; }
        }

        h1 {
            font-size: 4rem;
            letter-spacing: 3px;
            text-shadow:
                0 0 10px #ff00ff,
                0 0 20px #ff00ff,
                0 0 30px #ff00ff;
            margin-bottom: 15px;
            background: linear-gradient(45deg, #ff00ff, #8a2be2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .tagline {
            font-size: 1.4rem;
            font-style: italic;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
            letter-spacing: 1px;
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 50px;
        }

        .game-card {
            background: rgba(20, 0, 20, 0.7);
            border: 1px solid #ff00ff;
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(5px);
        }

        .game-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent,
                rgba(255, 0, 255, 0.1),
                transparent
            );
            transform: rotate(45deg);
            transition: transform 0.6s ease;
        }

        .game-card:hover {
            background: rgba(30, 0, 30, 0.8);
            transform: translateY(-8px) scale(1.02);
            box-shadow:
                0 15px 35px rgba(255, 0, 255, 0.3),
                inset 0 0 20px rgba(255, 0, 255, 0.1);
            border-color: #ff00ff;
        }

        .game-card:hover::before {
            transform: rotate(45deg) translateX(100%);
        }

        .game-card h2 {
            font-size: 2rem;
            margin-bottom: 20px;
            color: #ff00ff;
            text-shadow: 0 0 8px #ff00ff;
            position: relative;
            z-index: 2;
        }

        .game-card p {
            margin-bottom: 25px;
            line-height: 1.7;
            opacity: 0.95;
            position: relative;
            z-index: 2;
            font-size: 1.1rem;
        }

        .btn {
            display: inline-block;
            background: linear-gradient(135deg, rgba(40, 0, 40, 0.8), rgba(60, 0, 60, 0.8));
            border: 1px solid #ff00ff;
            color: #ff00ff;
            padding: 14px 32px;
            font-family: 'VT323', monospace;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            position: relative;
            z-index: 2;
            letter-spacing: 1px;
            border-radius: 8px;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 0, 255, 0.2),
                transparent
            );
            transition: left 0.5s ease;
        }

        .btn:hover {
            background: linear-gradient(135deg, rgba(60, 0, 60, 0.9), rgba(80, 0, 80, 0.9));
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 0, 255, 0.4);
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn:active {
            transform: translateY(0px);
        }

        #game-container {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(255, 0, 255, 0.5);
            border: 2px solid #ff00ff;
            margin-top: 30px;
            background: #000;
            min-height: 600px;
            display: none;
        }

        #game-container.active {
            display: block;
            animation: slideUp 0.6s ease-out;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        #game-frame {
            width: 100%;
            height: 100%;
            border: none;
            background: #000;
        }

        .game-controls {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }

        .control-btn {
            background: rgba(0, 0, 0, 0.7);
            border: 1px solid #ff00ff;
            color: #ff00ff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1.2rem;
        }

        .control-btn:hover {
            background: rgba(255, 0, 255, 0.2);
            transform: scale(1.1);
        }

        .info-section {
            background: rgba(20, 0, 20, 0.5);
            border-radius: 16px;
            padding: 30px;
            border: 1px solid #ff00ff;
            margin-top: 40px;
            backdrop-filter: blur(10px);
        }

        .info-section h2 {
            color: #ff00ff;
            margin-bottom: 20px;
            text-align: center;
            font-size: 2.2rem;
            text-shadow: 0 0 10px #ff00ff;
        }

        .info-section p {
            line-height: 1.8;
            opacity: 0.9;
            font-size: 1.1rem;
        }

        .footer {
            text-align: center;
            padding: 30px;
            border-top: 1px solid #ff00ff;
            margin-top: 50px;
            opacity: 0.8;
            font-size: 1rem;
            position: relative;
            z-index: 10;
        }

        .disclaimer {
            margin-top: 30px;
            padding: 20px;
            background: rgba(40, 0, 40, 0.6);
            border: 1px solid #8b008b;
            border-radius: 10px;
            font-size: 0.95rem;
            text-align: center;
        }

        @media (max-width: 1024px) {
            .games-grid {
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            }

            h1 {
                font-size: 3rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            h1 {
                font-size: 2.5rem;
                letter-spacing: 2px;
            }

            .tagline {
                font-size: 1.2rem;
            }

            .games-grid {
                grid-template-columns: 1fr;
            }

            .game-card {
                padding: 20px;
            }

            .info-section {
                padding: 20px;
                margin-top: 30px;
            }

            .control-btn {
                width: 35px;
                height: 35px;
                font-size: 1rem;
            }
        }

        @media (max-width: 480px) {
            h1 {
                font-size: 2rem;
            }

            .btn {
                padding: 12px 24px;
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>The Underground</h1>
            <p class="tagline">Where dreams and determination meet</p>
        </header>

        <section class="games-grid">
            <div class="game-card" data-game="undertale">
                <h2>Undertale</h2>
                <p>Explore the Underground, meet its inhabitants, and choose how your story unfolds. Every choice matters in this unique RPG where you can spare or fight your enemies.</p>
                <button class="btn load-game-btn" data-path="game/index.html">Play Undertale</button>
            </div>

            <div class="game-card" data-game="bad-time-simulator">
                <h2>Bad Time Simulator (Sans Fight)</h2>
                <p>Dodge a relentless barrage in this fan-made Sans battle. Test your reflexes against one of the toughest fights in the Underground.</p>
                <button class="btn load-game-btn" data-path="games/bad-time-simulator/index.html">Play Bad Time Simulator</button>
            </div>

            <div class="game-card" data-game="deltarune">
                <h2>Deltarune</h2>
                <p>Choose a chapter and journey into the Dark World. Continue the adventure from Toby Fox in this spin-off/sequel to Undertale.</p>
                <button class="btn load-game-btn" data-path="games/deltarune/index.html">Play Deltarune</button>
            </div>

            <div class="game-card" data-game="ovo">
                <h2>OvO</h2>
                <p>A fast-paced platformer where you slide, jump, and wall-jump through challenging levels. Test your precision and reflexes in this addictive skill-based game.</p>
                <button class="btn load-game-btn" data-path="games/ovo/index.html">Play OvO</button>
            </div>
        </section>

        <div id="game-container">
            <div class="game-controls">
                <button class="control-btn" id="back-btn" title="Back to Game Selection">←</button>
                <button class="control-btn" id="fullscreen-btn" title="Toggle Fullscreen">⛶</button>
            </div>
            <iframe id="game-frame" src="" allowfullscreen></iframe>
        </div>

        <section class="info-section">
            <h2>About The Underground</h2>
            <p>The Underground is a fan-made website dedicated to preserving and sharing the wonderful games created by Toby Fox. All games are loaded from their original sources and are played in their authentic browser ports.</p>
            <p>This site features a sleek purple-themed interface with embedded gameplay, allowing you to experience these beloved titles without leaving the site.</p>
        </section>

        <div class="disclaimer">
            <strong>Disclaimer:</strong> This is a fan-made project. All game content belongs to their respective creators. This site exists for preservation and fan enjoyment purposes only. Not affiliated with Toby Fox or the official game creators.
        </div>

        <footer class="footer">
            <p>&copy; 2026 The Underground. All rights reserved.</p>
            <p>Not affiliated with Toby Fox or the official game creators.</p>
        </footer>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const gameContainer = document.getElementById('game-container');
            const gameFrame = document.getElementById('game-frame');
            const backBtn = document.getElementById('back-btn');
            const fullscreenBtn = document.getElementById('fullscreen-btn');
            const loadGameBtns = document.querySelectorAll('.load-game-btn');
            const gamesGrid = document.querySelector('.games-grid');

            // Function to load a game
            function loadGame(gamePath) {
                gameFrame.src = gamePath;
                gameContainer.classList.add('active');
                gamesGrid.style.display = 'none';
            }

            // Function to go back to game selection
            function goBack() {
                gameFrame.src = ''; // Unload the game to save resources
                gameContainer.classList.remove('active');
                gamesGrid.style.display = 'grid';
            }

            // Function to toggle fullscreen
            function toggleFullscreen() {
                if (!document.fullscreenElement) {
                    gameContainer.requestFullscreen().catch(err => {
                        console.log(`Error attempting to enable fullscreen: ${err.message}`);
                    });
                } else {
                    document.exitFullscreen();
                }
            }

            // Event listeners for game buttons
            loadGameBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const gamePath = this.getAttribute('data-path');
                    loadGame(gamePath);
                });
            });

            // Event listener for back button
            backBtn.addEventListener('click', goBack);

            // Event listener for fullscreen button
            fullscreenBtn.addEventListener('click', toggleFullscreen);

            // Handle escape key to exit fullscreen or go back
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (document.fullscreenElement) {
                        document.exitFullscreen();
                    } else if (gameContainer.classList.contains('active')) {
                        goBack();
                    }
                }
            });

            // Handle fullscreen change events
            document.addEventListener('fullscreenchange', function() {
                if (document.fullscreenElement) {
                    fullscreenBtn.title = "Exit Fullscreen";
                    fullscreenBtn.innerHTML = "✕";
                } else {
                    fullscreenBtn.title = "Toggle Fullscreen";
                    fullscreenBtn.innerHTML = "⛶";
                }
            });
        });
    </script>
</body>
</html>